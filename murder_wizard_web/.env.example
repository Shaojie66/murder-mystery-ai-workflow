# Copy to .env before local production-style runs:
#   cp murder_wizard_web/.env.example murder_wizard_web/.env

# Backend runtime
JWT_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Choose one provider: claude / openai / ollama / minimax
LLM_PROVIDER=claude

# Claude / Anthropic
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# MiniMax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# Ollama
# For local Docker Compose on macOS/Windows, host.docker.internal works out of the box.
# On Linux, docker-compose.yml adds host-gateway mapping for the same hostname.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_API_KEY=ollama
